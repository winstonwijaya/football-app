# Copy to .env and adjust as needed.
#
# NOTE: the Go app reads plain environment variables (no dotenv library),
# so this file is NOT auto-loaded by `go run`. Docker Compose reads it
# automatically for variable substitution in docker-compose.yml. For local
# `go run` testing, source it into your shell first, e.g.:
#   set -a; source .env; set +a   (bash/zsh)

APP_PORT=8080

# 5433, not the default 5432 — avoids colliding with a Postgres instance
# that may already be running natively on your machine outside Docker.
# This only changes the *host-published* port; containers still talk to
# each other over the internal Docker network on 5432 regardless.
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=football
DB_SSLMODE=disable

# Any non-empty value; change this for anything beyond local dev.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRY_MINUTES=60

# docker-compose only: credentials for the admin user the `seed` service
# creates on startup. Change for anything beyond local dev.
SEED_USERNAME=admin
SEED_PASSWORD=admin12345
